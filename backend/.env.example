# Local Docker: SQLite stored in the named volume (no DB server needed)
DATABASE_URL=sqlite:////app/data/choremate.db

# Production (ECS): this is overridden by the SSM SecureString — don't set it here
# DATABASE_URL=postgresql://chorematadmin:password@rds-endpoint/choremate

SECRET_KEY=local-dev-secret-change-me
GEMINI_API_KEY=your-key-here

# ── SSE Notification backend ────────────────────────────────────────────────
# "memory" (default) — asyncio in-process queues, works for a single-process deploy
# "redis"            — Redis pub/sub fanout, required for multi-instance / ECS deployment
NOTIFICATION_BACKEND=memory

# Required only when NOTIFICATION_BACKEND=redis
# Local dev:      redis://localhost:6379/0
# AWS ElastiCache: redis://<cluster-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# ── LLM Configuration ───────────────────────────────────────────────────────
# Set to 'true' to bypass the Gemini API and use a 3-second simulated mock delay in the worker.
# This prevents rate limits and reduces cost during load testing.
USE_MOCK_LLM=false
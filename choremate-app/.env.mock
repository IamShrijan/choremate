# ─────────────────────────────────────────────────────────────
# ChoreMate Mock Backend Environment
# ─────────────────────────────────────────────────────────────
# Usage:
#   npm run dev:mock          → dev server with mock backend
#   npm run build:mock        → production build with mock backend (deploy-only)
#
# Delay config:
#   VITE_MOCK_DELAY_MS      normal endpoint latency (ms)  default: 200
#   VITE_MOCK_LLM_DELAY_MS  LLM endpoint latency (ms)     default: 3500
#
# Increase/decrease VITE_MOCK_LLM_DELAY_MS to simulate faster/slower AI.
# ─────────────────────────────────────────────────────────────

VITE_USE_MOCK=true
VITE_MOCK_DELAY_MS=200
VITE_MOCK_LLM_DELAY_MS=3500
# Mock SSE: how often the fake push fires in ms (simulates real notification push)
VITE_MOCK_SSE_INTERVAL_MS=8000

